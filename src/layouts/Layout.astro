---
import "bootstrap/dist/css/bootstrap.min.css";
import "@css/global.css";
import Header from "@components/Header.astro";

export interface Props {
  title: string;
  header?: boolean;
}

const { title, header = true }: Props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sitio web amigable e interactivo dónde doy a conocer mis habilidades de programación."
    />
    <meta itemprop="name" content="TRodolfo Andre Caballero Vilela" />
    <meta
      itemprop="description"
      content="Sitio web amigable e interactivo dónde doy a conocer mis habilidades de programación."
    />
    <meta
      itemprop="image"
      content="https://rodolfo-andre.vercel.app/icon.webp"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Rodolfo Andre Caballero Vilela" />
    <meta
      property="og:description"
      content="Sitio web amigable e interactivo dónde doy a conocer mis habilidades de programación."
    />
    <meta
      property="og:image"
      content="https://rodolfo-andre.vercel.app/screenshot.webp"
    />
    <meta property="og:url" content="https://rodolfo-andre.vercel.app" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/js/all.min.js"
      integrity="sha512-naukR7I+Nk6gp7p5TMA4ycgfxaZBJ7MO5iC3Fp6ySQyKFHOGfpkSZkYVWV5R7u7cfAicxanwYQ5D1e17EfJcMA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
  </head>
  <body>
    {header && <Header />}
    <slot />
  </body>
</html>

<script>
  import AOS from "aos";
  import "aos/dist/aos.css";

  AOS.init({
    once: true,
    delay: 200,
  });
</script>
